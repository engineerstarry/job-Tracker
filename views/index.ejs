<%- include("header.ejs") %>
    <div class="whole-body">
        <nav class="d-flex justify-content-center align-items-center gap-4">
            <div class="logo-div">
                <div>
                  <img src="images/image.png" alt="opportrack logo" class="">
                </div>
                <div>
                    <h1>OppoTrack</h1>
                    <p>Simple job application tracker</p>
                </div>

            </div>
            <div class="hamburger-menu">
                <button id="menu-btn">☰</button>
                <div id="menu" class="">
                    <a class="home" href="/">Home</a>
                    <a href="#works">How it works</a>
                    <a href="#about">About</a>

                    <a href="/trackers">Trackers</a>
                    <div class="line"></div>
                    <a class="newTracker" href="/startTracking">+ New Tracker</a>
                    <div class="/sign-in">
                  <p class="sign-in d-flex gap-2" href="/signIn.ejs">     <i class="bi bi-person-fill"></i> Sign in</a>
                    </div>

                    <p class="light"><i class="bi bi-gear-fill"></i> Light mode</p>
                    <div class="userName"></div>
                </div>
            </div>



        </nav>

        <section class="container Track-job">
            <div class="container">
                <p class="organise mt-4 ">Organize your job applications easier</p>
                <h2 class="mt-4">Track Every Job <br>
                    <span>Without The <br> Mess</span></h2>
                <p class="mt-3">
                    Jubro helps students, freelancers, and job seekers organize applications,
                    interviews, and job links in one clean and simple tracker.
                </p>
            </div>
            <a href="/startTracking" class="t-link mt-4">Start Tracking</a>
            <a href="#works" class="l-link mt-4">Learn More</a>
            <div>
                <div class="d-flex gap-3 mt-5">
                <div class="feature pe-3">
                    <h3>Simple</h3>
                    <p class="">Beginner friendly UI</p>
                </div>

                <div class="feature ">
                    <h3>Fast</h3>
                    <p class="">Track jobs instantly</p>
                    </div>
                </div>
                <div class="border-start small ps-3 mt-3">
                    <h3>
                        Clean
                    </h3>
                    <p class="">No clutter dashboard</p>
                </div>
            </div>


        </section>

        <section class="container trackers-container mt-5 ">
            <div>
       
                <% trackers.forEach(tracker => { %>
                <div class="tracker-card d-flex align-items-center gap-3">
              
                    <div class="pt-3">
                    <h3 class="text-nowrap"><%= tracker.jobName %></h3>
                    <p> <%= tracker.companyName %></p>
                    </div>
                   <div class="ms-auto status text-nowrap">
                    <p><%= tracker.applicationStatus %></p>
                    </div>
                </div>
                <hr>
             <%   }); %>
                    <a href="/trackers" class="mt-5">Open Trackers</a>
            </div>
        </section>

        <section id="works" class="container">
            <div class=" text-center step">
                <div class="how mb-5 mt-5 ">
             <p class="">How OpporTrack works</p>
                </div>
                
                <h3 class="font mb-4">In 3 Simple Steps</h3>
                <p>No complicated setup. Just create trackers, save applications,
                    and monitor your job progress in one clean dashboard.
                </p>
            </div>

            <div class="container">
                <div class="box mb-5 mt-5">
                    <div class="folder">
                        <i class="bi bi-folder-fill icon"></i>
                    </div>
                    <p class="s-font">
                        STEP 01
                    </p>
                    <h5>Create A Tracker</h5>
                    <p>Start by creating a tracker for internships, freelance jobs, remote work, or company
                        applications.</p>
                </div>

                <div class="box mb-5">
                    <div class="folder">
                        <i class="bi bi-briefcase-fill icon"></i>
                    </div>
                    <p class="s-font">
                        STEP 02
                    </p>
                    <h5>Save Job Applications</h5>
                    <p>
                        Add company names, positions, dates applied, status updates, and important job links.
                    </p>
                </div>

                <div class="box mb-5">
                    <div class="folder">
                        <i class="bi bi-graph-up icon"></i>
                    </div>
                    <p class="s-font">
                        STEP 03
                    </p>
                    <h5>Track Your Progress</h5>
                    <p>
                        Monitor interviews, rejections, pending applications, and organize your entire job hunting
                        journey.
                    </p>
                </div>

                <div>
                    <h5>
                        Keep Your Job Search Organized & Stress Free
                    </h5>
                    <p>
                        Jubro gives students, fresh graduates, and freelancers a simple way to manage applications
                        without
                        messy spreadsheets.</p>
                    <a href="startTracking">Start Tracking Now</a>
                </div>
            </div>

        </section>
        <section class="about">
            <p>
                About OppoTrack
            </p>
            <h5 id="about">
                ABOUT OppoTrack
            </h5>
            <p>
                Built For Students,
                Freelancers & Job Seekers
            </p>
            <p>
                OppoTrack is a simple job application tracker designed to help people organize applications, interviews,
                and opportunities without complicated dashboards or messy spreadsheets.
                Whether you're applying for internships, freelance projects, remote work,
                or full-time jobs, OppoTrack keeps everything organized in one clean and beginner-friendly workspace.

            </p>
            <div class="d-flex">
                <div class="check">
                    <i class="bi bi-check2"></i>
                </div>
                <div>
                    <h5>Simple & Minimal UI</h5>
                    <p>Easy to use even if you are not familiar with productivity tools.</p>
                </div>
            </div>

            <div class="d-flex">
                <div class="brief">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
                <div>
                    <h5>Track Job Applications</h5>
                    <p>Save positions, companies, statuses, and important job links.</p>
                </div>
            </div>

            <div class="d-flex">
                <div>
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
                <div>
                    <h5>Organize Everything</h5>
                    <p>Keep your entire job hunting journey in one place.</p>
                </div>
            </div>
        </section>

        <section class="ready">
            <div class="d-flex">
                <div>
                  <img src="images/image.png" alt="opportrack logo">
                </div>
                <p>OPPORTRACK</p>
            </div>
            <h6>
                Ready to organize your job journey?
            </h6>
            <p>Start tracking your applications and stay organized with Jubro.</p>
            <a href="/startTracking"></a>
        </section>
        <%- include("footer.ejs") %>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/index.js"></script>
    </body>

    </html>