<%- include("header.ejs") %>
<div class="container">
<h1>Job Application Trackers</h1>
<p>
    Create and open trackers for your job applications, interviews, and job links.
     Keep everything organized in one place.
</p>
</div>
<div class="trackers container">
  
<% trackers.forEach(tracker => { %>
    <div class="tracker-card">
        <p> <%= tracker.applicationDate %></p>
        <h2><%= tracker.jobName %></h2>
        <p> <%= tracker.companyName %></p>
        <p><%= tracker.applicationMedium %></p>
        <p>Date : <%= tracker.dateApplied %></p>
        <p>Status: <%= tracker.applicationStatus %></p>
      
   
    <%#     <form  method="POST" action="/trackersArray/tracker.id?_method=PATCH">
   <button type="submit" formaction="/trackersArray/tracker.id?_method=PATCH">
            <i class="bi bi-pencil-fill"></i></button>
                </form>
            %>
            <a href="/modify/<%= tracker.id %>/"> <i class="bi bi-pencil-fill"></i></a>
<form action="/delete/trackersArray/<%= tracker.id %>?_method=DELETE" method="POST">
    <button type="submit">
        <i class="bi bi-trash3-fill"></i>
    </button>
</form>
    </div>

<%}); %>
</div>
<%- include("footer.ejs") %>